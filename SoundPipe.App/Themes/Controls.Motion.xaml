<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    动效覆盖层（可选）：只做「不透明度的淡入淡出」，不含位移/缩放/视差，
    因此是"降低动效"场景下仍然安全的那一类过渡（Apple HIG 亦建议用 cross-dissolve 替代位移）。

    由 App.OnStartup 决定是否合并：
      · 系统「设置 → 辅助功能 → 视觉效果 → 动画效果」开启 → 合并本字典（150ms 淡入淡出）
      · 关闭 → 不合并，控件回落到 Controls.xaml 的即时状态切换

    注意：Storyboard 必须能冻结，所以 Duration 一律用字面量，
    不能在动画里使用 DynamicResource（会导致模板封存抛 InvalidOperationException）。
    本字典按"同键覆盖"生效，必须最后合并。
  -->

  <!-- ============================ 动画模板 ============================ -->

  <ControlTemplate x:Key="MotionButtonTemplate" TargetType="Button">
    <Grid>
      <Border x:Name="Base" CornerRadius="8" Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
              SnapsToDevicePixels="True" />
      <Border x:Name="Hover" CornerRadius="8" Background="#16FFFFFF" Opacity="0" />
      <Border x:Name="Press" CornerRadius="8" Background="#2AFFFFFF" Opacity="0" />
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Trigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                               To="1" Duration="0:0:0.15" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.EnterActions>
        <Trigger.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                               To="0" Duration="0:0:0.12" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.ExitActions>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Trigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="Opacity"
                               To="1" Duration="0:0:0.1" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.EnterActions>
        <Trigger.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="Opacity"
                               To="0" Duration="0:0:0.15" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.ExitActions>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Base" Property="Opacity" Value="0.38" />
        <Setter TargetName="Hover" Property="Opacity" Value="0" />
        <Setter TargetName="Press" Property="Opacity" Value="0" />
        <Setter Property="Cursor" Value="Arrow" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="MotionSegmentedRadioTemplate" TargetType="RadioButton">
    <Grid>
      <Border x:Name="Root" CornerRadius="7" Background="Transparent"
              BorderBrush="Transparent" BorderThickness="1" SnapsToDevicePixels="True" />
      <Border x:Name="Hover" CornerRadius="7" Background="#16FFFFFF" Opacity="0" />
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,0" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Trigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                               To="1" Duration="0:0:0.15" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.EnterActions>
        <Trigger.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                               To="0" Duration="0:0:0.12" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.ExitActions>
      </Trigger>
      <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Root" Property="Opacity" Value="0.38" />
        <Setter TargetName="Hover" Property="Opacity" Value="0" />
        <Setter Property="Cursor" Value="Arrow" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <!-- ============================ 同键覆盖的样式 ============================ -->
  <!-- 颜色等视觉定义与 Controls.xaml 保持一致，仅额外挂上动画模板 -->

  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template" Value="{StaticResource MotionButtonTemplate}" />
  </Style>

  <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Template" Value="{StaticResource MotionButtonTemplate}" />
  </Style>

  <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Template" Value="{StaticResource MotionButtonTemplate}" />
  </Style>

  <Style x:Key="SegmentedRadio" TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="Template" Value="{StaticResource MotionSegmentedRadioTemplate}" />
  </Style>

</ResourceDictionary>