<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!--
    SoundPipe 设计令牌（design tokens）
    来源：docs/design-system/MASTER.md（ui-ux-pro-max 生成）
    风格：Glassmorphism / 深色科技 + 状态绿
    规则：
      · 所有语义色只在此处定义，控件一律用 DynamicResource 引用
        （便于高对比度主题 HighContrast.xaml 整体替换）
      · 间距沿用 4/8 节奏；圆角 8（控件）/ 12（卡片）/ 999（胶囊）
      · 动效 150ms（微交互）～200ms（状态变化），由 Motion* 令牌统一控制
  -->

  <!-- ============================ 颜色 ============================ -->
  <Color x:Key="BgBaseColor">#0F172A</Color>
  <Color x:Key="SurfaceColor">#1B2336</Color>
  <Color x:Key="SurfaceMutedColor">#272F42</Color>
  <Color x:Key="AccentColor">#22C55E</Color>
  <Color x:Key="DestructiveColor">#EF4444</Color>
  <Color x:Key="WarningColor">#F59E0B</Color>

  <!-- 表面：半透明以呈现玻璃层次（若有 DWM 背景材质则透出 Mica/Acrylic） -->
  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F20F172A" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#E61B2336" />
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#F21B2336" />
  <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#80272F42" />
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#14FFFFFF" />
  <SolidColorBrush x:Key="SurfacePressedBrush" Color="#24FFFFFF" />

  <!-- 描边：1px rgba(white,0.12/0.2)，玻璃风格的关键 -->
  <SolidColorBrush x:Key="BorderSubtleBrush" Color="#1FFFFFFF" />
  <SolidColorBrush x:Key="BorderStrongBrush" Color="#33FFFFFF" />
  <SolidColorBrush x:Key="BorderBrush" Color="#475569" />

  <!-- 文字 -->
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8" />
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="#64748B" />
  <SolidColorBrush x:Key="TextOnAccentBrush" Color="#0F172A" />

  <!-- 语义状态 -->
  <SolidColorBrush x:Key="AccentBrush" Color="#22C55E" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#2FD96B" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="#1EA94F" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#2622C55E" />
  <SolidColorBrush x:Key="AccentTextBrush" Color="#4ADE80" />
  <SolidColorBrush x:Key="DestructiveBrush" Color="#EF4444" />
  <SolidColorBrush x:Key="DestructiveSoftBrush" Color="#26EF4444" />
  <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />
  <SolidColorBrush x:Key="WarningSoftBrush" Color="#26F59E0B" />
  <SolidColorBrush x:Key="RingBrush" Color="#F8FAFC" />

  <!-- 电平表：轨道 + 分级填充（绿 → 琥珀 → 红），对轨道对比度 ≥ 3:1 -->
  <SolidColorBrush x:Key="MeterTrackBrush" Color="#33272F42" />
  <LinearGradientBrush x:Key="MeterFillBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#22C55E" Offset="0.0" />
    <GradientStop Color="#22C55E" Offset="0.62" />
    <GradientStop Color="#F59E0B" Offset="0.82" />
    <GradientStop Color="#EF4444" Offset="1.0" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="MeterFillMicBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#60A5FA" Offset="0.0" />
    <GradientStop Color="#60A5FA" Offset="0.62" />
    <GradientStop Color="#F59E0B" Offset="0.82" />
    <GradientStop Color="#EF4444" Offset="1.0" />
  </LinearGradientBrush>

  <!-- ============================ 字体 ============================ -->
  <!-- 桌面端改用系统 UI 字体：离线可用、中文覆盖完整、无额外打包体积
       （MASTER.md 的 Plus Jakarta Sans 是 Web 字体，不适用于 WPF 桌面应用） -->
  <FontFamily x:Key="FontUi">Microsoft YaHei UI, Segoe UI, sans-serif</FontFamily>
  <FontFamily x:Key="FontDisplay">Segoe UI Variable Display, Microsoft YaHei UI, Segoe UI</FontFamily>
  <FontFamily x:Key="FontMono">Cascadia Mono, Consolas, Courier New</FontFamily>

  <sys:Double x:Key="FontSizeDisplay">21</sys:Double>
  <sys:Double x:Key="FontSizeTitle">14.5</sys:Double>
  <sys:Double x:Key="FontSizeBody">13</sys:Double>
  <sys:Double x:Key="FontSizeCaption">11.5</sys:Double>
  <sys:Double x:Key="FontSizeMono">12</sys:Double>

  <!-- ============================ 文字样式 ============================ -->
  <Style x:Key="DisplayText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeDisplay}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
  </Style>

  <Style x:Key="SectionTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style x:Key="BodyText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="LineHeight" Value="20" />
  </Style>

  <Style x:Key="CaptionText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="LineHeight" Value="16" />
  </Style>

  <Style x:Key="FieldLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>

  <!-- 等宽数字：电平读数 / PID，避免刷新时列宽跳动 -->
  <Style x:Key="MonoText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeMono}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <!-- ============================ 卡片 ============================ -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="18" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

</ResourceDictionary>